// ── PING TEST ──
function doPing() {
    const btn = document.querySelector('.sec-net .btn-green');
    const msg = document.getElementById('ping-msg');
    const st = document.getElementById('sl-status');
    const ids = [['p-mum', 15], ['p-pun', 18], ['p-che', 22], ['p-sin', 55], ['p-hkg', 75]];
    if (btn) { btn.innerHTML = '<i data-lucide="loader-2" width="16" height="16" style="animation: spin 1s linear infinite;"></i> Scanning...'; lucide.createIcons({ root: btn }); btn.style.pointerEvents = 'none'; }
    if (st) { st.textContent = 'RUNNING'; st.style.color = '#22c55e'; st.style.background = 'rgba(34,197,94,.1)'; }
    ids.forEach(el => { const e = document.getElementById(el[0]); if (e) { e.textContent = '...'; e.className = 'slp'; } });
    let i = 0;
    const iv = setInterval(() => {
        if (i >= ids.length) {
            clearInterval(iv);
            if (btn) { btn.innerHTML = '<i data-lucide="activity" width="16" height="16"></i> Test Again'; lucide.createIcons({ root: btn }); btn.style.pointerEvents = ''; }
            if (msg) msg.textContent = '✓ Complete! Closest: Mumbai (15ms)';
            if (st) { st.textContent = 'IDLE'; st.style.color = ''; st.style.background = ''; }
            return;
        }
        const [id, ms] = ids[i++];
        const el = document.getElementById(id);
        if (el) { el.textContent = ms + ' ms'; el.className = 'slp ' + (ms < 60 ? 'ok' : ms < 120 ? 'med' : ''); }
    }, 650);
}


function goSlide(idx) {
    const oldActive = document.querySelector('.hero-slide.active');

    // Force DOM reflow to restart CSS animation correctly
    slides.forEach(s => s.classList.remove('prev', 'active'));
    void slides[idx].offsetWidth;

    if (oldActive) oldActive.classList.add('prev');
    slides[idx].classList.add('active');

    const gEl = document.getElementById('hero-game');
    if (gEl) {
        gEl.style.opacity = '0'; gEl.style.transform = 'translateY(10px)';
        const pAmt = document.getElementById('hero-price-amt');
        const pSub = document.getElementById('hero-price-sub');
        if (pAmt) pAmt.style.opacity = '0';

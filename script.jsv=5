        { name: "EMERALD", price: "₹1920", cat: "Premium", ram: 48 },
        { name: "NETHERITE", price: "₹2560", cat: "Premium", ram: 64 }
    ];

    let calcCtx = {
        players: 12,
        mods: 0,
        type: 'Spigot/Paper',
        version: '1.21.x',
        light: 10,
        med: 5,
        heavy: 0,
        mode: 0 // 0=Auto, 1=Budget, 2=Power
    };

    const E = {
        plr: document.getElementById('calcPlayers'), pVal: document.getElementById('calcPlayersVal'), pFill: document.getElementById('playersFill'),
        mods: document.getElementById('calcMods'), mVal: document.getElementById('calcModsVal'), mFill: document.getElementById('modsFill'),
        lght: document.getElementById('pLight'), lVal: document.getElementById('pLightV'), lFill: document.getElementById('lFill'),
        med: document.getElementById('pMed'), m2Val: document.getElementById('pMedV'), m2Fill: document.getElementById('mFill'),
        hvy: document.getElementById('pHeavy'), hVal: document.getElementById('pHeavyV'), hFill: document.getElementById('hFill'),

        ram: document.getElementById('calcRamVal'),
        tierGlider: document.getElementById('tierGlider'),
        arch: document.getElementById('archStatus'), tps: document.getElementById('tpsStatus'),
        fBtn: document.getElementById('finalBtnSpan'),

        c1n: document.getElementById('cp1-name'), c1p: document.getElementById('cp1-price'), c1c: document.getElementById('cp1-cat'),
        c2n: document.getElementById('cp2-name'), c2p: document.getElementById('cp2-price'), c2c: document.getElementById('cp2-cat'),
        c3n: document.getElementById('cp3-name'), c3p: document.getElementById('cp3-price'), c3c: document.getElementById('cp3-cat')
    };

    if (!E.plr) return; // not on page

    function updateFill(sliderEl, fillEl, pVal) {
        let percent = ((sliderEl.value - sliderEl.min) / (sliderEl.max - sliderEl.min)) * 100;
        if (fillEl) fillEl.style.width = percent + '%';
        if (pVal) pVal.textContent = sliderEl.value;
    }

    function hookSlider(sl, fill, val, key) {
        sl.addEventListener('input', () => {
            calcCtx[key] = parseInt(sl.value);
            updateFill(sl, fill, val);
            recalc();
        });
        updateFill(sl, fill, val);
    }

    hookSlider(E.plr, E.pFill, E.pVal, 'players');
    hookSlider(E.mods, E.mFill, E.mVal, 'mods');
    hookSlider(E.lght, E.lFill, E.lVal, 'light');
    hookSlider(E.med, E.m2Fill, E.m2Val, 'med');
    hookSlider(E.hvy, E.hFill, E.hVal, 'heavy');

    // Advanced Accordion
    const aBtn = document.getElementById('advToggle');
    const aChv = document.getElementById('advChevron');
    const aCon = document.getElementById('advContent');
    if (aBtn) {
        aBtn.addEventListener('click', () => {
            const isO = aCon.style.height && aCon.style.height !== '0px';
            aCon.style.height = isO ? '0px' : aCon.scrollHeight + 'px';
            aChv.style.transform = isO ? 'rotate(0deg)' : 'rotate(180deg)';
        });
    }

    // Reset plugins
    document.getElementById('resetPlugins')?.addEventListener('click', () => {
        E.lght.value = 0; E.med.value = 0; E.hvy.value = 0;
        E.lght.dispatchEvent(new Event('input'));
        E.med.dispatchEvent(new Event('input'));
        E.hvy.dispatchEvent(new Event('input'));
    });

    // Custom Dropdowns
    ['type', 'version'].forEach(k => {
        const btn = document.getElementById(k + 'Btn');
        const menu = document.getElementById(k + 'Menu');
        const span = document.getElementById('selected' + (k === 'type' ? 'Type' : 'Version'));
        if (!btn) return;
        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = menu.style.opacity === '1';
            document.querySelectorAll('[id$="Menu"]').forEach(m => { m.style.opacity = '0'; m.style.pointerEvents = 'none'; m.style.transform = 'translateY(-10px)'; });
            if (!isOpen) {
                menu.style.opacity = '1'; menu.style.pointerEvents = 'auto'; menu.style.transform = 'translateY(0)';
            }
        });
        menu.querySelectorAll('button').forEach(item => {
            item.addEventListener('click', () => {
                menu.querySelectorAll('button').forEach(i => { i.classList.replace('text-white', 'text-blue-200'); i.classList.remove('font-semibold'); });
                item.classList.replace('text-blue-200', 'text-white'); item.classList.add('font-semibold');
                const t = item.textContent;
                span.textContent = t;
                calcCtx[k] = t;
                // Add minor multiplier for modern versions
                if (k === 'version') recalc();
                // Add minor multiplier for modpacks
                if (k === 'type') {
                    if (t === 'Forge/Fabric' && calcCtx.mods < 30) { E.mods.value = 30; E.mods.dispatchEvent(new Event('input')); }
                    recalc();
                }
            });
        });
    });

    // Close dropdowns on document click
    document.addEventListener('click', () => {
        document.querySelectorAll('[id$="Menu"]').forEach(m => { m.style.opacity = '0'; m.style.pointerEvents = 'none'; m.style.transform = 'translateY(-10px)'; });
    });

    // Tier segment
    const tierBtns = document.querySelectorAll('.tier-btn');
    tierBtns.forEach((b) => {
        b.addEventListener('click', () => {
            const idx = parseInt(b.dataset.idx);
            calcCtx.mode = idx;
            E.tierGlider.style.left = `calc(${idx * 33.333}% + 4px)`;
            tierBtns.forEach(tb => { tb.classList.replace('text-white', 'text-blue-300'); });
            b.classList.replace('text-blue-300', 'text-white');
            recalc();
        });
    });

    // Quick Presets
    document.querySelectorAll('#calcPresets button').forEach(b => {
        b.addEventListener('click', () => {
            document.querySelectorAll('#calcPresets button').forEach(bc => {
                bc.className = "group relative px-4 py-3 rounded-2xl bg-white/5 border border-white/5 text-blue-100 font-medium transition-all hover:bg-blue-500/10 hover:border-blue-400/20 active:scale-95";
            });
            b.className = "group relative px-4 py-3 rounded-2xl bg-blue-500/15 border border-blue-400/30 text-white font-semibold transition-all shadow-[0_0_15px_rgba(59,130,246,0.2)]";
            let d = b.dataset.preset;
            if (d === 'survival') { setSl(12, 0, 10, 5, 0); }
            if (d === 'skyblock') { setSl(30, 0, 25, 20, 5); }
            if (d === 'light') { setSl(5, 50, 0, 0, 0); }
            if (d === 'heavy') { setSl(15, 150, 0, 0, 0); }
        });
    });

    function setSl(p, m, l, md, h) {
        E.plr.value = p; E.mods.value = m; E.lght.value = l; E.med.value = md; E.hvy.value = h;
        [E.plr, E.mods, E.lght, E.med, E.hvy].forEach(s => s.dispatchEvent(new Event('input')));
    }

    function recalc() {
        // Base math calculation
        let pBase = Math.ceil(calcCtx.players / 8);
        let mBase = Math.ceil(calcCtx.mods / 30);
        let plugBase = Math.ceil(calcCtx.light * 0.05) + Math.ceil(calcCtx.med * 0.15) + Math.ceil(calcCtx.heavy * 0.5);
        let verMul = (calcCtx.version.includes('1.21') || calcCtx.version.includes('1.20') || calcCtx.version.includes('1.19')) ? 1.5 : 0;

        // Total Ram Required
        let calculated = Math.max(2, pBase + mBase + plugBase + verMul);
        calculated = Math.ceil(calculated);

        E.ram.textContent = calculated;

        // Visual Status
        if (calculated < 6) { E.arch.innerHTML = '<i data-lucide="check-circle" class="w-4 h-4 text-green-400 mr-1"></i> Stable'; E.tps.innerHTML = '<i data-lucide="check-circle" class="w-4 h-4 text-green-400 mr-1"></i> Nominal'; }
        else if (calculated < 12) { E.arch.innerHTML = '<i data-lucide="check-circle" class="w-4 h-4 text-green-400 mr-1"></i> Excellent'; E.tps.innerHTML = '<i data-lucide="check-circle" class="w-4 h-4 text-green-400 mr-1"></i> Low Risk'; }
        else { E.arch.innerHTML = '<i data-lucide="check-circle" class="w-4 h-4 text-green-400 mr-1"></i> Excellent'; E.tps.innerHTML = '<i data-lucide="check-circle" class="w-4 h-4 text-green-400 mr-1"></i> Zero Risk'; }

        // Find best match loop
        let listToUse = budgetPlans;
        if (calcCtx.mode === 1) { listToUse = perfPlans; }
        else if (calcCtx.mode === 2) { listToUse = premPlans; }

        // Find the index in listToUse that covers the ram
        let bestIdx = listToUse.findIndex(pl => pl.ram >= calculated);
        if (bestIdx === -1) bestIdx = listToUse.length - 1; // max out

        let iLow = Math.max(0, bestIdx - 1);
        let iMid = bestIdx;
        let iHigh = Math.min(listToUse.length - 1, bestIdx + 1);

        if (iMid === 0 && listToUse.length > 2) { iHigh = 2; }
        if (iMid === listToUse.length - 1 && listToUse.length > 2) { iLow = listToUse.length - 3; }

        let p_l = listToUse[iLow], p_m = listToUse[iMid], p_r = listToUse[iHigh];

        E.c1n.textContent = p_l.name; E.c1p.textContent = p_l.price; E.c1c.textContent = p_l.cat;
        E.c2n.textContent = p_m.name; E.c2p.textContent = p_m.price; E.c2c.textContent = p_m.cat;
        E.c3n.textContent = p_r.name; E.c3p.textContent = p_r.price; E.c3c.textContent = p_r.cat;

        E.fBtn.textContent = p_m.name;

        if (window.lucide) lucide.createIcons();
    }


    if (!t) {
        t = document.createElement('div');
        t.id = '__toast';
        t.style.cssText = 'position:fixed;bottom:32px;left:50%;transform:translateX(-50%) translateY(16px);background:rgba(10,14,30,0.95);color:#fff;border:1px solid rgba(59,130,246,0.35);border-radius:12px;padding:14px 28px;font-size:15px;font-weight:600;letter-spacing:-0.02em;z-index:99998;box-shadow:0 8px 32px rgba(0,0,0,0.4);backdrop-filter:blur(16px);transition:all 0.35s cubic-bezier(0.22,1,0.36,1);opacity:0;pointer-events:none;';

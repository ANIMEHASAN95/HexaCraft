});

// ── NAVBAR: transparent at top, solidifies when scrolled ──
function updateNavbar() {
    const nav = document.getElementById('navbar');
    const promo = document.getElementById('promo-bar');
    if (!nav) return;
    const ph = (promo && promo.style.display !== 'none' && promo.offsetParent !== null)
        ? promo.offsetHeight : 0;

    // adjust navbar top based on scroll to push it below promo when at top
    nav.style.top = Math.max(0, ph - window.scrollY) + 'px';

    // navbar uses margin-top internally, so just track scroll state
    nav.classList.toggle('scrolled', window.scrollY > ph + 10);
}
window.addEventListener('scroll', updateNavbar, { passive: true });
window.addEventListener('resize', updateNavbar);
document.addEventListener('DOMContentLoaded', updateNavbar);

